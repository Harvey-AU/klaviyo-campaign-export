# Copy to brands/<brand>.env (gitignored) and run with --brand <brand>.
KLAVIYO_PRIVATE_API_KEY=
CAMPAIGN_EXPORT_CAMPAIGN=
CAMPAIGN_EXPORT_SHEET=
# Optional
CAMPAIGN_EXPORT_METRIC=Bloom Campaign Response
CAMPAIGN_EXPORT_TOP=50
CAMPAIGN_EXPORT_EXCLUDE_DOMAINS=
CAMPAIGN_EXPORT_TIMEZONE=Australia/Sydney
CAMPAIGN_EXPORT_SAME_PERSON=brands/<brand>.same-person.json
